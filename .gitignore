# ── Dati / file audio scaricati (troppo grandi per GitHub) ──────────────
downloads/
stems/
covers/
anteprime/
modelli/
.trash/
.snapshots/

# ── Cache Python e file di sistema ───────────────────────────────────────
__pycache__/
*.pyc
.DS_Store

# ── File temporanei di download ──────────────────────────────────────────
*.part
*.ytdl
*.f*.mp4
*.f*.m4a

# ── File temporanei del database ─────────────────────────────────────────
*.db-journal
*.db-wal
*.db-shm

# ── Cookie di sessione ───────────────────────────────────────────────────
# Il file COMPLETO (con la sessione del browser) resta SOLO sul Mac: è usato
# dall'app per i download. Nella repo c'è solo la versione snellita
# (anti-403, senza dati di account). Non caricare mai il file completo.
cookies.txt

# ── MIDI Studio: file generati e log restano solo in locale ──────────────
midi_studio/files/
midi_studio/logs/


# ── Output di nohup (creato quando un comando in background non redirige) ──
nohup.out

# ── Legacy: `dataset.json` è rigenerato dall'app ─────────────────────────
# Lo riscrive `save_dataset()` a ogni campione salvato (compatibilità con lo
# scraper storico) ed è ridondante col database: non va versionato.
dataset.json
